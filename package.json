{
  "name": "moodmatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db": "node scripts/test-astra.mjs",
    "data": "node scripts/merge-movies.mjs",
    "data:prepare": "node scripts/prepare-data.mjs",
    "data:validate": "node scripts/validate-data.mjs",
    "data:fetch-recent": "node scripts/fetch-recent-movies.mjs",
    "data:recent": "node scripts/validate-data.mjs data/recent-movies.csv",
    "data:all": "node scripts/validate-data.mjs data/all-movies.csv",
    "embeddings:dry-run": "node scripts/test-embeddings.mjs --limit 5",
    "embeddings:test": "node scripts/test-embeddings.mjs --live --limit 5",
    "test": "node --test tests/*.test.mjs",
    "test:offline": "node --test tests/*.test.mjs",
    "embeddings:local": "node scripts/test-local-embeddings.mjs",
    "embeddings:benchmark": "node scripts/benchmark-embeddings.mjs",
    "embeddings:build:dry-run": "node scripts/build-local-embeddings.mjs --dry-run",
    "embeddings:build:sample": "node scripts/build-local-embeddings.mjs --sample",
    "db:ingest:dry-run": "node scripts/ingest-movies.mjs --limit 5",
    "db:ingest:sample": "node scripts/ingest-movies.mjs --apply --limit 5",
    "db:vector:test": "node scripts/test-vector-search.mjs",
    "db:batch": "node scripts/ingest-batch.mjs",
    "db:batch:dry-run": "node scripts/ingest-batch.mjs --dry-run",
    "db:batch:sample": "node scripts/ingest-batch.mjs --apply --limit 10 --infer-missing",
    "db:preflight": "node scripts/preflight-ingestion.mjs",
    "db:preflight:remote": "node scripts/preflight-ingestion.mjs --remote-read-only",
    "db:schema-v2:audit": "node scripts/audit-vector-schema-v2.mjs"
  },
  "dependencies": {
    "@datastax/astra-db-ts": "^2.3.0",
    "@huggingface/transformers": "4.3.1",
    "cheerio": "1.0.0",
    "csv-parser": "^3.2.1",
    "dotenv": "^18.0.6",
    "next": "16.4.0",
    "openai": "^7.30.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
